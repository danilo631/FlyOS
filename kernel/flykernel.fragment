# Fly OS desktop responsiveness fragment
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_SCHED_AUTOGROUP=y
CONFIG_UCLAMP_TASK=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y

# Modern CPU frequency scaling; schedutil remains a safe generic default.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Block I/O choices. Fly OS selects BFQ only for rotational media at runtime.
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y

# Networking.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_FQ=y

# Memory compression and modern reclaim support.
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=n
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_LRU_GEN=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_NTSYNC=m

# Debuggability / reproducibility.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Keep security features enabled.
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
