#!/usr/bin/env bash
set -e
case "${1:-}" in
  configure)
    /usr/lib/flyos/fly-identity || true
    if command -v systemctl >/dev/null 2>&1; then
      systemctl enable flyos-tune.service >/dev/null 2>&1 || true
      systemctl enable flyos-security-init.service >/dev/null 2>&1 || true
      systemctl enable flyos-identity.service >/dev/null 2>&1 || true
    fi
  ;;
esac
exit 0
