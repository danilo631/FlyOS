#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import sys
sys.path.insert(0, '/usr/lib/flyos')
from flyplatform import brightness_percent, set_brightness_percent
cur=brightness_percent()
if len(sys.argv)==1:
    print(cur); raise SystemExit(0 if cur >= 0 else 1)
a=sys.argv[1]
if a in {'up','down'}:
    target=(cur if cur >= 0 else 50)+(5 if a=='up' else -5)
elif a.isdigit(): target=int(a)
else: raise SystemExit(2)
raise SystemExit(0 if set_brightness_percent(target) else 1)
