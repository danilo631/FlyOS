#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import sys
sys.path.insert(0, '/usr/lib/flyos')
from flyplatform import media_action, media_state
if len(sys.argv) < 2:
    title, artist, playing, _ = media_state()
    print(f"{'playing' if playing else 'paused'}\t{artist}\t{title}")
    raise SystemExit(0 if title else 1)
raise SystemExit(0 if media_action(sys.argv[1]) else 1)
