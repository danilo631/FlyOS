#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import argparse, sys
sys.path.insert(0, '/usr/lib/flyos')
from flyplatform import notify
p=argparse.ArgumentParser(description='Send a notification through the Fly notification service')
p.add_argument('summary'); p.add_argument('body', nargs='?', default='')
p.add_argument('--critical', action='store_true'); p.add_argument('--expire-ms', type=int, default=4500)
a=p.parse_args()
raise SystemExit(0 if notify(a.summary, a.body, urgency=2 if a.critical else 1, expire_ms=a.expire_ms) else 1)
