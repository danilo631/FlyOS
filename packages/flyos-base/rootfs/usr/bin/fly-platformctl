#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import sys
sys.path.insert(0,'/usr/lib/flyos')
from flyplatform import kwin_reconfigure, notify
cmd=sys.argv[1] if len(sys.argv)>1 else ''
if cmd=='kwin-reconfigure': raise SystemExit(0 if kwin_reconfigure() else 1)
if cmd=='notify' and len(sys.argv)>=3: raise SystemExit(0 if notify(sys.argv[2],sys.argv[3] if len(sys.argv)>3 else '') else 1)
raise SystemExit(2)
