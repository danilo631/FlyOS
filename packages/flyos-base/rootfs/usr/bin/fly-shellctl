#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import os
import subprocess
import sys
import time
from pathlib import Path

cmd = sys.argv[1] if len(sys.argv) > 1 else "launcher"
config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "flyos"
config.mkdir(parents=True, exist_ok=True)

if cmd == "disable":
    (config / "shell-disabled").touch()
    subprocess.run(["systemctl", "--user", "stop", "fly-shell.service"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("Fly Shell desativado para este usuário. Use 'fly-shellctl enable' para restaurar.")
    raise SystemExit(0)
if cmd == "reset":
    settings = config / "settings.json"
    backup = None
    if settings.exists():
        backup = settings.with_name(f"settings.json.bak-{time.strftime('%Y%m%d-%H%M%S')}")
        try:
            settings.replace(backup)
        except OSError as exc:
            print(f"Não foi possível salvar o backup das configurações: {exc}", file=sys.stderr)
            raise SystemExit(1)
    (config / "shell-disabled").unlink(missing_ok=True)
    subprocess.run(["systemctl", "--user", "set-environment", "FLYOS_SAFE_MODE=1"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "--user", "reset-failed", "fly-shell.service"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    result = subprocess.run(["systemctl", "--user", "restart", "fly-shell.service"], check=False,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if backup:
        print(f"Configurações anteriores preservadas em: {backup}")
    print("Fly Shell restaurado com configurações padrão em modo seguro.")
    raise SystemExit(result.returncode)

if cmd == "enable":
    (config / "shell-disabled").unlink(missing_ok=True)
    # Leaving Rescue Safe UI must be explicit; otherwise the systemd user
    # manager would keep FLYOS_SAFE_MODE=1 for later shell restarts.
    subprocess.run(["systemctl", "--user", "unset-environment", "FLYOS_SAFE_MODE"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "--user", "reset-failed", "fly-shell.service"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "--user", "restart", "fly-shell.service"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("Fly Shell ativado no modo normal.")
    raise SystemExit(0)

allowed = {"launcher", "quick", "notifications", "overview", "health", "settings", "apps", "settings-reload"}
osd = cmd.startswith("osd-volume:") or cmd.startswith("osd-brightness:")
if cmd not in allowed and not osd:
    print("Uso: fly-shellctl [launcher|quick|notifications|overview|health|settings|apps|settings-reload|enable|disable|reset|osd-volume:N|osd-brightness:N]", file=sys.stderr)
    raise SystemExit(2)

runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
runtime.mkdir(parents=True, exist_ok=True)
path = runtime / "fly-shell-command"
try:
    # O_APPEND keeps rapid shortcut presses from overwriting one another. Each
    # command is tiny enough to be appended atomically for a single user.
    with path.open("a", encoding="utf-8") as stream:
        stream.write(cmd + "\n")
except OSError as exc:
    print(f"Não foi possível contatar o Fly Shell: {exc}", file=sys.stderr)
    raise SystemExit(1)
