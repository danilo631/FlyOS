#!/usr/bin/env bash
set -euo pipefail
cmd="${1:-}"
command -v wpctl >/dev/null 2>&1 || exit 1
case "$cmd" in
  up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  *) echo "Usage: fly-volume up|down|mute" >&2; exit 2 ;;
esac
sleep 0.05
line="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
value="$(awk '{printf "%d", $2*100}' <<<"$line" 2>/dev/null || echo 0)"
[[ "$line" == *MUTED* ]] && value=0
fly-shellctl "osd-volume:${value:-0}" >/dev/null 2>&1 || true
