import os, sys
from pathlib import Path
if os.geteuid() != 0:
    print('root required', file=sys.stderr); raise SystemExit(1)
try: value=int(sys.argv[1])
except (IndexError, ValueError): raise SystemExit(2)
if not 50 <= value <= 100: raise SystemExit(2)
changed=0
for bat in Path('/sys/class/power_supply').glob('BAT*'):
    for name in ('charge_control_end_threshold','charge_stop_threshold'):
        p=bat/name
        if p.exists():
            try: p.write_text(str(value)); changed += 1
            except OSError as e: print(f'{p}: {e}', file=sys.stderr)
print(f'Battery Care: limite aplicado em {changed} interface(s).')
raise SystemExit(0 if changed else 3)
