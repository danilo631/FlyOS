"""Fly OS freedesktop notification daemon.

This intentionally implements a conservative subset of the Desktop
Notifications specification. Notifications are kept only for the current user
session under XDG_RUNTIME_DIR; the shell renders toasts and the history panel.
"""
from __future__ import annotations

import html
import json
import os
import re
import time
from pathlib import Path

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

TAG_RE = re.compile(r"<[^>]+>")


def clean(value: object, limit: int) -> str:
    text = html.unescape(TAG_RE.sub("", str(value or "")))
    return " ".join(text.split())[:limit]


class Notifications(dbus.service.Object):
    def __init__(self) -> None:
        self.runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
        self.runtime.mkdir(parents=True, exist_ok=True)
        self.store = self.runtime / "fly-notifications.json"
        self.command = self.runtime / "fly-notification-command"
        self.shell_command = self.runtime / "fly-shell-command"
        self.items: list[dict] = []
        self.next_id = 1
        self.expirations: dict[int, int] = {}
        self._load()

        bus = dbus.SessionBus()
        self.name = dbus.service.BusName("org.freedesktop.Notifications", bus=bus, do_not_queue=True)
        super().__init__(bus, "/org/freedesktop/Notifications")
        GLib.timeout_add(180, self._consume_commands)

    def _load(self) -> None:
        try:
            data = json.loads(self.store.read_text(encoding="utf-8"))
            if isinstance(data, list):
                self.items = [x for x in data if isinstance(x, dict)][-100:]
                # A daemon restart invalidates old active notification IDs. Keep
                # the session history, but never resurrect actions/timeouts.
                for item in self.items:
                    item["closed"] = True
                    item["actions"] = []
                if self.items:
                    self.next_id = max(int(x.get("id", 0)) for x in self.items) + 1
        except (OSError, ValueError, TypeError, json.JSONDecodeError):
            self.items = []

    def _write(self) -> None:
        tmp = self.store.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.items[-100:], ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        os.chmod(tmp, 0o600)
        tmp.replace(self.store)

    def _poke_shell(self, command: str) -> None:
        try:
            with self.shell_command.open("a", encoding="utf-8") as stream:
                stream.write(command + "\n")
        except OSError:
            pass

    def _cancel_expiration(self, ident: int) -> None:
        source = self.expirations.pop(ident, None)
        if source is not None:
            try:
                GLib.source_remove(source)
            except (TypeError, ValueError):
                pass

    def _archive_expired(self, ident: int) -> bool:
        self.expirations.pop(ident, None)
        item = next((x for x in self.items if int(x.get("id", -1)) == ident and not bool(x.get("closed", False))), None)
        if not item:
            return False
        item["closed"] = True
        item["actions"] = []
        item["closed_reason"] = 1
        self._write()
        self.NotificationClosed(dbus.UInt32(ident), dbus.UInt32(1))
        self._poke_shell("notifications-refresh")
        return False

    def _schedule_expiration(self, ident: int, timeout_ms: int, urgency: int) -> None:
        self._cancel_expiration(ident)
        if timeout_ms == 0:
            return
        if timeout_ms < 0:
            # Server policy: low/normal notifications time out, critical ones
            # stay until acted upon or explicitly closed.
            timeout_ms = 6000 if urgency <= 0 else (9000 if urgency == 1 else 0)
        if timeout_ms <= 0:
            return
        timeout_ms = max(1000, min(timeout_ms, 120000))
        self.expirations[ident] = GLib.timeout_add(timeout_ms, self._archive_expired, ident)

    def _remove(self, ident: int, reason: int = 3) -> None:
        self._cancel_expiration(ident)
        before = len(self.items)
        self.items = [x for x in self.items if int(x.get("id", -1)) != ident]
        if len(self.items) != before:
            self._write()
            self.NotificationClosed(dbus.UInt32(ident), dbus.UInt32(reason))
            self._poke_shell("notifications-refresh")

    def _consume_commands(self) -> bool:
        try:
            content = self.command.read_text(encoding="utf-8")
            self.command.unlink(missing_ok=True)
        except OSError:
            return True
        for line in content.splitlines():
            line = line.strip()
            if line == "clear":
                active_ids = [
                    int(x.get("id", 0)) for x in self.items
                    if not bool(x.get("closed", False))
                ]
                for ident in active_ids:
                    self._cancel_expiration(ident)
                self.items.clear()
                self._write()
                for ident in active_ids:
                    self.NotificationClosed(dbus.UInt32(ident), dbus.UInt32(2))
                self._poke_shell("notifications-refresh")
            elif line.startswith("close:"):
                try:
                    self._remove(int(line.split(":", 1)[1]), 2)
                except ValueError:
                    pass
            elif line.startswith("action:"):
                try:
                    _, raw_id, action_key = line.split(":", 2)
                    ident = int(raw_id)
                except (ValueError, TypeError):
                    continue
                item = next((x for x in self.items if int(x.get("id", -1)) == ident and not bool(x.get("closed", False))), None)
                if not item:
                    continue
                allowed = {str(a.get("key", "")) for a in item.get("actions", []) if isinstance(a, dict)}
                if action_key not in allowed:
                    continue
                self.ActionInvoked(dbus.UInt32(ident), action_key)
                if not bool(item.get("resident", False)):
                    self._remove(ident, 2)
        return True

    @dbus.service.method("org.freedesktop.Notifications", out_signature="as")
    def GetCapabilities(self):
        return dbus.Array(["actions", "body", "persistence"], signature="s")

    @dbus.service.method("org.freedesktop.Notifications", out_signature="ssss")
    def GetServerInformation(self):
        return ("Fly Notifications", "Fly OS Project", "0.10", "1.3")

    @dbus.service.method(
        "org.freedesktop.Notifications",
        in_signature="susssasa{sv}i",
        out_signature="u",
    )
    def Notify(self, app_name, replaces_id, app_icon, summary, body, actions, hints, expire_timeout):
        ident = int(replaces_id or 0)
        if ident <= 0 or not any(int(x.get("id", -1)) == ident and not bool(x.get("closed", False)) for x in self.items):
            ident = self.next_id
            self.next_id += 1

        urgency = 1
        try:
            urgency = int(hints.get("urgency", 1))
        except (AttributeError, TypeError, ValueError):
            pass
        action_items: list[dict[str, str]] = []
        raw_actions = list(actions or [])
        for index in range(0, min(len(raw_actions), 12), 2):
            if index + 1 >= len(raw_actions):
                break
            key = clean(raw_actions[index], 120)
            label = clean(raw_actions[index + 1], 120)
            if key:
                action_items.append({"key": key, "label": label or ("Abrir" if key == "default" else key)})

        resident = False
        try:
            resident = bool(hints.get("resident", False))
        except AttributeError:
            pass

        item = {
            "id": ident,
            "app": clean(app_name, 80) or "Aplicativo",
            "summary": clean(summary, 180) or "Notificação",
            "body": clean(body, 1000),
            "icon": clean(app_icon, 200),
            "urgency": max(0, min(2, urgency)),
            "actions": action_items,
            "resident": resident,
            "closed": False,
            "timestamp": int(time.time()),
        }
        self.items = [x for x in self.items if int(x.get("id", -1)) != ident]
        self.items.append(item)
        self.items = self.items[-100:]
        self._write()
        try:
            timeout_ms = int(expire_timeout)
        except (TypeError, ValueError):
            timeout_ms = -1
        if not resident:
            self._schedule_expiration(ident, timeout_ms, urgency)
        self._poke_shell(f"notification:{ident}")
        return dbus.UInt32(ident)

    @dbus.service.method("org.freedesktop.Notifications", in_signature="u")
    def CloseNotification(self, ident):
        value = int(ident)
        if any(int(x.get("id", -1)) == value and not bool(x.get("closed", False)) for x in self.items):
            self._remove(value, 3)

    @dbus.service.signal("org.freedesktop.Notifications", signature="uu")
    def NotificationClosed(self, ident, reason):
        pass

    @dbus.service.signal("org.freedesktop.Notifications", signature="us")
    def ActionInvoked(self, ident, action_key):
        pass


def main() -> int:
    DBusGMainLoop(set_as_default=True)
    try:
        Notifications()
    except dbus.exceptions.NameExistsException:
        # Another desktop notification daemon already owns the standard name.
        return 0
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
