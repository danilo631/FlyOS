#!/usr/bin/env bash
set -euo pipefail

export XDG_CURRENT_DESKTOP=FlyOS
export XDG_SESSION_DESKTOP=FlyOS
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export NIXOS_OZONE_WL=1

# Make the Wayland/session environment visible to D-Bus and user services.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd --all >/dev/null 2>&1 || true
fi
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID >/dev/null 2>&1 || true

# Start the generic graphical-session targets so XDG autostart generators,
# desktop portals and PolicyKit agents behave like they do in mature desktops.
systemctl --user start graphical-session-pre.target graphical-session.target >/dev/null 2>&1 || true

# The Fly target keeps independent components restartable. A shell crash should
# not tear down KWin or log the user out.
systemctl --user start flyos-session.target

cleanup() {
  systemctl --user stop flyos-session.target >/dev/null 2>&1 || true
  systemctl --user stop graphical-session.target >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM HUP

while systemctl --user is-active --quiet flyos-session.target; do
  sleep 1
done
