[Unit]
Description=Fly Shell
PartOf=flyos-session.target
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=8
OnFailure=fly-rescue-ui.service

[Service]
Slice=fly-interactive.slice
Type=simple
ExecStart=/usr/bin/fly-shell
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
OOMPolicy=continue

[Install]
WantedBy=flyos-session.target
