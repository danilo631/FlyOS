Window.SetBackgroundTopColor(0.035, 0.045, 0.070);
Window.SetBackgroundBottomColor(0.015, 0.020, 0.032);

logo_image = Image.Text("FLY OS", 0.94, 0.96, 1.0);
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 16);

status_image = Image.Text("starting", 0.45, 0.65, 1.0);
status_sprite = Sprite(status_image);
status_sprite.SetX(Window.GetWidth() / 2 - status_image.GetWidth() / 2);
status_sprite.SetY(Window.GetHeight() / 2 + 42);

fun refresh_callback () {
    progress = Plymouth.GetBootProgress();
    status_sprite.SetOpacity(0.35 + 0.65 * progress);
}
Plymouth.SetRefreshFunction(refresh_callback);
