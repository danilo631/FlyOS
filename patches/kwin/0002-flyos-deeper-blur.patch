From 1111111111111111111111111111111111111111 Mon Sep 17 00:00:00 2001
From: Fly OS Project <devnull@example.invalid>
Date: Wed, 30 Sep 2026 00:00:00 -0300
Subject: [PATCH] effects/blur: add a high-strength Fly OS blur step

This optional FlyKWin patch exposes a deeper blur range for translucent Fly OS
surfaces. It is deliberately not used by the default signed-kernel/stock-KWin
ISO because carrying a permanent KWin fork increases security-update burden.

Upstream file license: GPL-2.0-or-later.
---
 src/plugins/blur/blur.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/plugins/blur/blur.cpp b/src/plugins/blur/blur.cpp
--- a/src/plugins/blur/blur.cpp
+++ b/src/plugins/blur/blur.cpp
@@ -107,7 +107,7 @@ void BlurEffect::initBlurStrengthValues()
 {
     // This function creates an array of blur strength values that are evenly distributed
     // The range of the slider on the blur settings UI
-    int numOfBlurSteps = 15;
+    int numOfBlurSteps = 18;
     int remainingSteps = numOfBlurSteps;
@@ -131,7 +131,8 @@ void BlurEffect::initBlurStrengthValues()
     blurOffsets.append({2.0, 3.0, 20}); // Down sample size / 4
     blurOffsets.append({2.0, 5.0, 50}); // Down sample size / 8
     blurOffsets.append({3.0, 8.0, 150}); // Down sample size / 16
-    // blurOffsets.append({5.0, 10.0, 400}); // Down sample size / 32
+    // Fly OS: reserve the final steps for a stronger glass backdrop.
+    blurOffsets.append({5.0, 10.0, 400}); // Down sample size / 32
     // blurOffsets.append({7.0, ?.0}); // Down sample size / 64
-- 
